# ─────────────────────────────────────────────────────────────────────────────
# LocalListing AI — Environment Variables
# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI Provider Selection ─────────────────────────────────────────────────────
# "ollama"  → use local Ollama instance (default when no key is present)
# "hosted"  → use a hosted OpenAI-compatible API
AI_PROVIDER=ollama

# ── Ollama (local inference) ──────────────────────────────────────────────────
# URL of your local Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Vision model to use — run `ollama pull gemma3:4b` to install the default
OLLAMA_MODEL=gemma3:4b

# Maximum time (ms) to wait for a vision inference response (default: 2 min)
OLLAMA_TIMEOUT_MS=120000

# ── Hosted / Cloud inference (optional) ──────────────────────────────────────
# Required when AI_PROVIDER=hosted (or when you want cloud fallback).
# Get a key from https://openrouter.ai or any other OpenAI-compatible provider.
HOSTED_AI_API_KEY=

# Base URL of the hosted inference API
HOSTED_AI_BASE_URL=https://openrouter.ai/api/v1

# Model identifier on the hosted provider
HOSTED_AI_MODEL=google/gemma-3-27b-it

# Maximum time (ms) to wait for a hosted inference response (default: 1 min)
HOSTED_AI_TIMEOUT_MS=60000
